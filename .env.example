# Server Configuration
PORT=5050

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inquirybox
DB_USER=postgres
DB_PASSWORD=your_password_here

# Authentication (generate a unique random value of at least 32 characters)
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1h
JSON_LIMIT=32kb
AUTH_RATE_LIMIT=30

# Used only by `npm run admin:create`; remove after bootstrap
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
