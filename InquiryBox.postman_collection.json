            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"Sarah Jenkins\",\n  \"email\": \"sarah.j@example.com\",\n  \"phone\": \"+1-555-0199\",\n  \"subject\": \"Inquiry about catering packages\",\n  \"message\": \"Hi, I am planning a 50-person family reunion next month and would like details on your buffet menu options.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/enquiries",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "enquiries"
          ]
        },
        "description": "Submits a new customer enquiry (status defaults to 'new')"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('enquiryId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
