{
  "name": "inquirybox",
  "version": "1.0.0",
  "description": "Customer enquiry management REST API for a local small business",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "db:migrate": "node src/scripts/migrate.js",
    "admin:create": "node src/scripts/createAdmin.js",
    "test": "node --test test/api.test.js",
    "test:postgres": "node test/postgres.integration.js"
  },
  "keywords": [
